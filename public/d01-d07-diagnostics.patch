+    /// Summarize observed questgiver/gossip panels against preceding `Open` and `Select` writes.
+    pub(crate) fn panel_correlations(&self) -> Vec<String> {
+        let gaps = self.has_telemetry_gaps();
+        self.entries
+            .iter()
