+                (fields::CONTAINER_FIELD_NUM_SLOTS, 8),
+                (fields::CONTAINER_ALIGN_PAD, 0xBEEF),
+                (fields::CONTAINER_FIELD_SLOT_1, ITEM as u32),
+                (fields::CONTAINER_FIELD_SLOT_1 + 1, (ITEM >> 32) as u32),
