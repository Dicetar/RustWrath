+            (11, 11),     // GAMEOBJECT_PARENTROTATION[1] -> FIELD_GAMEOBJECT_ROTATION[1]
+            (12, 12),     // GAMEOBJECT_PARENTROTATION[2] -> FIELD_GAMEOBJECT_ROTATION[2]
+            (13, 13),     // GAMEOBJECT_PARENTROTATION[3] -> FIELD_GAMEOBJECT_ROTATION[3]
