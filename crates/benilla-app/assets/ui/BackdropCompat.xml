<!-- The 9.x BackdropTemplate name backport: 3.3.5a frames already carry SetBackdrop and its
     colour setters, so the template only has to exist for CreateFrame(..., "BackdropTemplate"). -->
<Ui>
    <Script>
        -- The mixin object 9.x addons pass to Mixin(frame, BackdropTemplateMixin). The frame
        -- methods (SetBackdrop, SetBackdropColor, SetBackdropBorderColor) live on the 3.3.5a
        -- frame itself.
        BackdropTemplateMixin = BackdropTemplateMixin or {}
    </Script>
    <Frame name="BackdropTemplate" virtual="true"/>
    <Frame name="DialogBorderOpaqueTemplate" virtual="true">
        <Size>
            <AbsDimension x="320" y="240"/>
        </Size>
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <BackgroundInsets>
                <AbsInset left="11" right="12" top="12" bottom="11"/>
            </BackgroundInsets>
            <TileSize>
                <AbsValue val="32"/>
            </TileSize>
            <EdgeSize>
                <AbsValue val="32"/>
            </EdgeSize>
        </Backdrop>
    </Frame>
    <Frame name="InsetFrameTemplate" virtual="true">
        <Size>
            <AbsDimension x="256" y="128"/>
        </Size>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
            <BackgroundInsets>
                <AbsInset left="5" right="5" top="5" bottom="5"/>
            </BackgroundInsets>
            <TileSize>
                <AbsValue val="16"/>
            </TileSize>
            <EdgeSize>
                <AbsValue val="16"/>
            </EdgeSize>
        </Backdrop>
    </Frame>
    <Button name="MainHelpPlateButton" virtual="true">
        <Size>
            <AbsDimension x="32" y="32"/>
        </Size>
    </Button>
    <Button name="ActionBarButtonSpellActivationAlert" virtual="true">
        <Size>
            <AbsDimension x="64" y="64"/>
        </Size>
    </Button>
    <Button name="MicroButtonAlertTemplate" virtual="true">
        <Size>
            <AbsDimension x="300" y="32"/>
        </Size>
    </Button>
    <ScrollFrame name="ScrollFrameTemplate" virtual="true">
        <Size>
            <AbsDimension x="256" y="128"/>
        </Size>
    </ScrollFrame>
    <Frame name="ModelWithControlsTemplate" virtual="true">
        <Size>
            <AbsDimension x="256" y="256"/>
        </Size>
    </Frame>
</Ui>
