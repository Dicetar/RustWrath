+    /// RustWrath patch: order the replay by what each crate's captured rustc command actually
+    /// links (`--extern name=path`). This is the ground truth of the fat build, so it backs up the
+    /// cargo-metadata walk in `workspace_hotpatch_replay_order`, which once put benilla_app before
+    /// the optional dependency its `hotpatch` feature enables. Ties keep the incoming order.
+    fn workspace_hotpatch_order_by_externs(
+        &self,
+        workspace_rustc_args: &WorkspaceRustcArgs,
+        crates: Vec<String>,
+    ) -> Result<Vec<String>> {
+        let externs_of = |crate_name: &str| -> HashSet<String> {
+            let mut externs = HashSet::new();
+            let Some(args) = self.workspace_hotpatch_replay_args(workspace_rustc_args, crate_name)
+            else {
+                return externs;
+            };
+            let mut after_extern_flag = false;
+            for arg in &args.args {
+                let spec = if after_extern_flag {
+                    Some(arg.as_str())
+                } else {
+                    arg.strip_prefix("--extern=")
+                };
+                after_extern_flag = arg == "--extern";
+                if let Some(spec) = spec {
+                    // `[opts:]name[=path]`
+                    let name = spec.split('=').next().unwrap_or(spec);
+                    let name = name.rsplit(':').next().unwrap_or(name);
+                    externs.insert(name.replace('-', "_"));
+                }
+            }
+            externs
+        };
+
+        let position: HashMap<&String, usize> =
+            crates.iter().enumerate().map(|(i, name)| (name, i)).collect();
+        let mut indegree = vec![0usize; crates.len()];
+        let mut dependents: Vec<Vec<usize>> = vec![vec![]; crates.len()];
+        for (i, crate_name) in crates.iter().enumerate() {
+            for dep in externs_of(crate_name) {
+                if let Some(&j) = position.get(&dep) {
+                    if j != i {
+                        indegree[i] += 1;
+                        dependents[j].push(i);
+                    }
+                }
+            }
+        }
+
+        let mut ready: BTreeSet<usize> = (0..crates.len()).filter(|&i| indegree[i] == 0).collect();
+        let mut ordered = Vec::with_capacity(crates.len());
+        while let Some(i) = ready.pop_first() {
+            ordered.push(crates[i].clone());
+            for &d in &dependents[i] {
+                indegree[d] -= 1;
+                if indegree[d] == 0 {
+                    ready.insert(d);
+                }
+            }
+        }
+
+        ensure!(
+            ordered.len() == crates.len(),
+            "Cycle in captured --extern arguments — cannot determine replay order"
+        );
+        Ok(ordered)
+    }
